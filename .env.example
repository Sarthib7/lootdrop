# --- Database ---
# SQLite file used by both the bot and the MCP server (WAL mode is set automatically).
DATABASE_URL="file:./lootdrop.db"

# --- Discord (M0-07) ---
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
# Guild used for command registration and the demo (community_id == guild id).
DISCORD_GUILD_ID=""
# Channel that receives public audit log messages.
DISCORD_LOG_CHANNEL_ID=""
# Role allowed to create/approve rewards.
DISCORD_ADMIN_ROLE_ID=""

# --- Bitrefill (M0-06) ---
# Mode: "mock" (default, no key needed) or "live" (Personal API key, test products only).
BITREFILL_MODE="mock"
BITREFILL_API_KEY=""
BITREFILL_API_BASE="https://api.bitrefill.com/v2"

# --- MCP server identity (bound at startup, never client-supplied) ---
LOOTDROP_COMMUNITY_ID=""
LOOTDROP_AGENT_ID="agent:game-agent"
