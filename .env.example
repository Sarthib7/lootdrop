# --- Database (PostgreSQL) ---
# Local dev and Railway both use Postgres. On Railway, set this to the reference
# variable ${{Postgres.DATABASE_URL}} so it points at the internal database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lootdrop?schema=public"

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=""
# Optional: comma-separated numeric user ids always treated as admins, in
# addition to each group's creator/administrators.
TELEGRAM_ADMIN_IDS=""
# Optional: override the chat id where public, redacted audit lines are posted.
# Defaults to the community group the reward was created in.
TELEGRAM_LOG_CHAT_ID=""
# Health-check port (Railway injects PORT automatically).
PORT="3000"

# --- Discord bot (optional second platform) ---
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""
DISCORD_LOG_CHANNEL_ID=""
DISCORD_ADMIN_ROLE_ID=""

# --- Bitrefill (test products only) ---
# "mock" (default, no key) or "live" (Personal API key; keep to test products).
BITREFILL_MODE="mock"
BITREFILL_API_KEY=""
BITREFILL_API_BASE="https://api.bitrefill.com/v2"

# --- MCP server identity (bound at startup, never client-supplied) ---
# The community id this MCP instance serves (a Telegram chat id or Discord guild id).
LOOTDROP_COMMUNITY_ID=""
LOOTDROP_AGENT_ID="agent:game-agent"
# Platform used by the seed script: "telegram" (default) or "discord".
LOOTDROP_PLATFORM="telegram"
